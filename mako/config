# Notifications styled to match ~/.config/ironbar/style.css.

font=SauceCodePro Nerd Font 11
background-color=#28272CF5
text-color=#F0EBE8FF
border-color=#8FA8BDFF
progress-color=over #B6FF5CFF

width=360
height=140
outer-margin=12
margin=4
padding=12,16
border-size=1
border-radius=10

icons=1
max-icon-size=48
icon-border-radius=8
markup=1
format=<b>%s</b>\n<span foreground="#BBB4BA">%b</span>

anchor=top-right
layer=top
max-visible=3
group-by=app-name,summary

# Keep a retrievable history, but never let a client create a permanent popup.
history=1
max-history=50
ignore-timeout=1
default-timeout=5000

[urgency=low]
border-color=#66636EFF
default-timeout=4000

[urgency=critical]
border-color=#FF5268FF
default-timeout=9000
