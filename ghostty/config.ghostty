# Ghostty mirrors kitty/kitty.conf: same font, padding, opacity, colors and
# split keys. Ghostty is used where touch input is needed; kitty's Wayland
# backend ignores the touchscreen.

font-family = Maple Mono NF
font-size = 12

window-padding-x = 15
window-padding-y = 15
background-opacity = 0.95
background-blur = 5
window-theme = ghostty

# Tab bar styled like kitty's: bottom edge, always shown, compact tabs, no
# titlebar (Hyprland draws none for kitty either). Colors live in tabs.css.
gtk-titlebar = false
gtk-tabs-location = bottom
window-show-tab-bar = always
gtk-wide-tabs = false
gtk-toolbar-style = flat
window-title-font-family = Maple Mono NF
gtk-custom-css = tabs.css

cursor-style = block
cursor-style-blink = false
cursor-color = #fff7f2
cursor-text = #151517
shell-integration-features = no-cursor

confirm-close-surface = false

# Later_This_Evening, as in kitty/theme.conf.
background = #212121
foreground = #949494
selection-background = #424242
selection-foreground = #212121
palette = 0=#2b2b2b
palette = 1=#d35a5f
palette = 2=#afba66
palette = 3=#e5d289
palette = 4=#a0b9d5
palette = 5=#bf92d5
palette = 6=#91beb6
palette = 7=#3b3c3c
palette = 8=#444747
palette = 9=#d3222e
palette = 10=#aabb39
palette = 11=#e4bd39
palette = 12=#6599d5
palette = 13=#aa52d5
palette = 14=#5fbfad
palette = 15=#c0c2c2

keybind = ctrl+shift+k=clear_screen
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+0=reset_font_size
keybind = ctrl+shift+h=write_scrollback_file:open
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+enter=unbind
keybind = ctrl+shift+e=new_split:right
keybind = ctrl+shift+arrow_left=goto_split:left
keybind = ctrl+shift+arrow_right=goto_split:right
keybind = ctrl+shift+arrow_up=goto_split:up
keybind = ctrl+shift+arrow_down=goto_split:down
